; Engine configuration file.

config_version=5

[application]

config/name="Sideways"
config/description="Realistic split-screen gravel rally."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

GameNight="*res://addons/gamenight/gamenight.gd"
GameNightScreen="*res://addons/gamenight/screen.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gamenight/plugin.cfg")

[physics]

common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=12
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
shader_compiler/shader_cache/enabled=true

[shader_globals]

canopy_map={
"type": "sampler2D",
"value": ""
}
canopy_rect={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
wetness={
"type": "float",
"value": 0.0
}
ground_map={
"type": "sampler2D",
"value": ""
}
ground_rect={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
